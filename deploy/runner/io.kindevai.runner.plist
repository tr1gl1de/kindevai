<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  kindevai Runner as a launchd user agent (macOS); runs as you, so AI CLIs use your own logins.
  Install (replace YOUR_USER with your short user name, see `id -un`):
    sudo install -m 0755 ai-runner /usr/local/bin/ai-runner
    ai-runner enroll with your Control Plane URL (see README, section Runner)
    sed "s/YOUR_USER/$(id -un)/g" io.kindevai.runner.plist > ~/Library/LaunchAgents/io.kindevai.runner.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.kindevai.runner.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.kindevai.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ai-runner</string>
    <string>run</string>
    <string>--data-dir</string>
    <string>/Users/YOUR_USER/.local/share/kindevai-runner</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- KIN-64: unloading or restarting the agent stops only the daemon; attempt processes (own process groups)
       keep running and the next start adopts them. To stop them too, disable the runner in the Dashboard. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/kindevai-runner.log</string>
</dict>
</plist>
