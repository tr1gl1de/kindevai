# kindevai Runner as a user service (Linux, WSL2): runs as you, so AI CLIs use your own logins.
# Install:
#   install -D -m 0755 ai-runner ~/.local/bin/ai-runner
#   install -D -m 0644 kindevai-runner-user.service ~/.config/systemd/user/kindevai-runner.service
#   ~/.local/bin/ai-runner enroll --server https://kindevai.example.com
#   systemctl --user daemon-reload && systemctl --user enable --now kindevai-runner
#   loginctl enable-linger "$USER"   # keep it running without an open session
[Unit]
Description=kindevai Runner (user)
Documentation=https://github.com/tr1gl1de/kindevai

[Service]
Type=simple
ExecStart=%h/.local/bin/ai-runner run --data-dir %h/.local/share/kindevai-runner
UMask=0077
Restart=on-failure
RestartSec=5s
# 78 (EX_CONFIG): not enrolled or an insecure/mismatched key; restarting cannot fix it.
RestartPreventExitStatus=78
# KIN-64: stop/restart signals only the daemon. Attempt processes run in their own process groups and keep running
# through a crash restart (Restart=on-failure), an upgrade and `systemctl stop`; the next start adopts them from
# its attempt journal (pid + start time). To stop the attempts too, disable the runner in the Dashboard (it stops
# them itself, KIN-63) or run `systemctl --user kill kindevai-runner` (whole cgroup). Machine shutdown ends them anyway.
# systemd then logs that unit processes remain after stop; they stay in the unit's cgroup until they end (an
# attempt ends on its own, is cancelled once the runner is back, or is killed by the commands above).
KillMode=process
TimeoutStopSec=60s
NoNewPrivileges=yes

[Install]
WantedBy=default.target
