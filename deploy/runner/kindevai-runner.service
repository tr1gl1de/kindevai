# kindevai Runner as a system service (Linux, WSL2 with systemd enabled).
# Install:
#   sudo install -m 0755 ai-runner /usr/local/bin/ai-runner
#   sudo useradd --system --home-dir /var/lib/kindevai-runner --shell /usr/sbin/nologin kindevai-runner
#   sudo install -m 0644 kindevai-runner.service /etc/systemd/system/
#   sudo install -d -m 0700 -o kindevai-runner -g kindevai-runner /var/lib/kindevai-runner
#   sudo -u kindevai-runner ai-runner enroll --server https://kindevai.example.com --data-dir /var/lib/kindevai-runner
#   sudo systemctl daemon-reload && sudo systemctl enable --now kindevai-runner
[Unit]
Description=kindevai Runner
Documentation=https://github.com/tr1gl1de/kindevai
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kindevai-runner
Group=kindevai-runner
ExecStart=/usr/local/bin/ai-runner run --data-dir /var/lib/kindevai-runner
StateDirectory=kindevai-runner
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
# 78 (EX_CONFIG): not enrolled or an insecure/mismatched key; restarting cannot fix it.
RestartPreventExitStatus=78
# KIN-64: stop/restart signals only the daemon. Attempt processes run in their own process groups and keep running
# through a crash restart (Restart=on-failure), an upgrade and `systemctl stop`; the next start adopts them from
# its attempt journal (pid + start time). To stop the attempts too, disable the runner in the Dashboard (it stops
# them itself, KIN-63) or run `systemctl kill kindevai-runner` (whole cgroup). Machine shutdown ends them anyway.
# systemd then logs that unit processes remain after stop; they stay in the unit's cgroup until they end (an
# attempt ends on its own, is cancelled once the runner is back, or is killed by the commands above).
KillMode=process
TimeoutStopSec=60s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
